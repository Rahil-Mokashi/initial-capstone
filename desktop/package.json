{
  "name": "pperp-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Petrol Pump ERP desktop shell (Electron)",
  "author": "Petrol Pump ERP",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "e2e": "npm run build && playwright test",
    "dist": "npm run build && electron-builder --win nsis",
    "print-test": "node scripts/print-test/run.cjs",
    "test:packaged": "node scripts/opt-in.cjs packaged",
    "test:deep-path": "node scripts/opt-in.cjs deep-path",
    "test:screenshots": "node scripts/opt-in.cjs screenshots",
    "test:print-spike": "node scripts/opt-in.cjs print-spike"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.0.3"
  }
}
